{
  "note": "Rule colors. `id` matches the annotation class from the Quran.com tajweed text. Longer madd = deeper blue.",
  "classes": [
    {"id": "madda_normal", "name": "Natural Madd", "arabic": "المد الطبيعي", "short": "Stretch 2 counts", "sample": "ا", "light": "#3B82F6", "dark": "#7CB3FF", "lesson": "madd-tabeei"},
    {"id": "madda_permissible", "name": "Permissible Madd", "arabic": "المد الجائز", "short": "Stretch 2, 4 or 6 counts (when stopping)", "sample": "ي", "light": "#6D4CE8", "dark": "#A99BFF", "lesson": "madd-aarid"},
    {"id": "madda_obligatory", "name": "Obligatory Madd", "arabic": "المد الواجب", "short": "Stretch 4 to 5 counts", "sample": "ا", "light": "#1D3FBF", "dark": "#8499FF", "lesson": "madd-muttasil"},
    {"id": "madda_necessary", "name": "Necessary Madd", "arabic": "المد اللازم", "short": "Stretch 6 counts", "sample": "ا", "light": "#0B1F7A", "dark": "#B6A4FF", "lesson": "madd-lazim"},
    {"id": "qalaqah", "name": "Qalqalah", "arabic": "القلقلة", "short": "A little echo or bounce", "sample": "د", "light": "#E0303F", "dark": "#FF7A85", "lesson": "qalqalah"},
    {"id": "ghunnah", "name": "Ghunnah", "arabic": "الغنة", "short": "Nasal hum for 2 counts", "sample": "نّ", "light": "#E8790C", "dark": "#FFA64D", "lesson": "ghunnah"},
    {"id": "ikhafa", "name": "Ikhfa", "arabic": "الإخفاء", "short": "Hide the noon, hum 2 counts", "sample": "ن", "light": "#A12BC4", "dark": "#D68CFF", "lesson": "ikhfa"},
    {"id": "ikhafa_shafawi", "name": "Ikhfa Shafawi", "arabic": "الإخفاء الشفوي", "short": "Hide the meem before ba", "sample": "م", "light": "#D91E91", "dark": "#FF8FD0", "lesson": "ikhfa-shafawi"},
    {"id": "idgham_ghunnah", "name": "Idgham with Ghunnah", "arabic": "الإدغام بغنة", "short": "Merge with a nasal hum", "sample": "ن", "light": "#0F9D87", "dark": "#4FD9C0", "lesson": "idgham-ghunnah"},
    {"id": "idgham_wo_ghunnah", "name": "Idgham without Ghunnah", "arabic": "الإدغام بغير غنة", "short": "Merge with no nasal hum", "sample": "ن", "light": "#2F9E2F", "dark": "#7FDC7F", "lesson": "idgham-bila-ghunnah"},
    {"id": "idgham_shafawi", "name": "Idgham Shafawi", "arabic": "الإدغام الشفوي", "short": "Merge meem into meem", "sample": "م", "light": "#6FA300", "dark": "#B5E64D", "lesson": "idgham-shafawi"},
    {"id": "iqlab", "name": "Iqlab", "arabic": "الإقلاب", "short": "Flip the noon into a meem", "sample": "ن", "light": "#0A93D6", "dark": "#58C7FF", "lesson": "iqlab"},
    {"id": "idgham_mutajanisayn", "name": "Idgham Mutajanisayn", "arabic": "إدغام المتجانسين", "short": "Merge two letters from the same spot", "sample": "د", "light": "#B8860B", "dark": "#F0C24D", "lesson": "idgham-two-letters"},
    {"id": "idgham_mutaqaribayn", "name": "Idgham Mutaqaribayn", "arabic": "إدغام المتقاربين", "short": "Merge two close letters", "sample": "ل", "light": "#8A5A2B", "dark": "#E0A674", "lesson": "idgham-two-letters"},
    {"id": "ham_wasl", "name": "Hamzat al-Wasl", "arabic": "همزة الوصل", "short": "Connecting alif: skipped when joined", "sample": "ٱ", "light": "#9A97A8", "dark": "#8C8A9C", "lesson": "hamzat-wasl"},
    {"id": "laam_shamsiyah", "name": "Lam Shamsiyyah", "arabic": "اللام الشمسية", "short": "The lam is silent; double the next letter", "sample": "ل", "light": "#9A97A8", "dark": "#8C8A9C", "lesson": "lam-shamsiyyah"},
    {"id": "slnt", "name": "Silent letter", "arabic": "حرف لا يُنطق", "short": "Written but not pronounced", "sample": "ا", "light": "#9A97A8", "dark": "#8C8A9C", "lesson": "silent-letters"}
  ]
}
